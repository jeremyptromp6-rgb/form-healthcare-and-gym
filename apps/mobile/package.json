{
  "name": "@form/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/copy-pose-assets.mjs && expo start --web",
    "postinstall": "node scripts/copy-pose-assets.mjs",
    "test": "jest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/copy-pose-assets.mjs && expo export --platform web --output-dir dist"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@form/domain$": "<rootDir>/../../packages/domain/src/index.ts"
    },
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/afterEach.ts"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.25",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  }
}
