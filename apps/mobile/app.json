{
  "expo": {
    "name": "FORM",
    "slug": "form",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "form",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F8F7",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.form.fitness"
    },
    "android": {
      "package": "app.form.fitness",
      "adaptiveIcon": {
        "backgroundColor": "#F5F8F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.health.READ_STEPS"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F8F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "dark": {
            "backgroundColor": "#0B0F0E",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "FORM uses a photo you choose only as your private profile picture.",
          "cameraPermission": "FORM uses your camera to track your movement during workouts (video stays on this device and is never recorded), to photograph meals you choose to scan, and to read food barcodes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FORM uses your camera to track your movement during workouts (video stays on this device and is never recorded), to photograph meals you choose to scan, and to read food barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#10B981",
          "defaultChannel": "reminders"
        }
      ],
      "react-native-health-connect",
      ["expo-build-properties", { "android": { "minSdkVersion": 26 } }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
