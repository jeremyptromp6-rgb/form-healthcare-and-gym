{
  "expo": {
    "name": "FORM",
    "slug": "form",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "form",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF5EC",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.form.fitness"
    },
    "android": {
      "package": "app.form.fitness",
      "adaptiveIcon": {
        "backgroundColor": "#FBF5EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF5EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#17110E",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "FORM uses a photo you choose only as your private profile picture.",
          "cameraPermission": "FORM uses your camera to track your movement on this device during workouts. Video is never recorded or uploaded.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FORM uses your camera to track your movement on this device during workouts. Video is never recorded or uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
