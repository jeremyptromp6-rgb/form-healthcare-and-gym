# Local settings for the FORM API. Copy to apps/api/.env (gitignored). Every name below is read by
# apps/api/src/config.ts or the provider/backup code; the values shown are the defaults unless noted.
# Leave a line out (or commented) to use the default; blank values are fine only where marked.

# --- Core ---------------------------------------------------------------------------------------
NODE_ENV=development
# Required in production: at least 32 random characters. Blank in development = an ephemeral secret
# (sessions reset on restart).
JWT_SECRET=
# SQLite file path. Use :memory: for throwaway runs.
DATABASE_PATH=./form.db
PORT=4000
# Comma-separated origins allowed to call the API (Expo web dev server by default). Production
# requires an explicit list (no "*").
CORS_ORIGINS=http://localhost:8081
# Session lifetime: a number plus s, m, h or d. Default 30d; "sign out on all devices" and a password
# change revoke every session at once whatever this is.
TOKEN_TTL=30d
# Reverse-proxy hops whose X-Forwarded-For entry is trusted for the client IP (production only).
# Default 1 = Render's load balancer. Raise only if a CDN is added in front.
TRUST_PROXY_HOPS=1
# Per-client request ceiling per minute (auth routes have their own, stricter limits).
RATE_LIMIT_PER_MINUTE=300
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# "testing" marks a throwaway pre-launch server where the sandbox store may run even with
# NODE_ENV=production. "live" (the default) refuses it. Remove before real users.
APP_STAGE=live

# --- Food scanner -------------------------------------------------------------------------------
# anthropic (Claude vision; needs ANTHROPIC_API_KEY), gemini (Google Gemini, has a free tier; needs
# GEMINI_API_KEY), development (a labelled sample meal for local testing only, refused in
# production) or none (scanning reports unavailable).
FOOD_RECOGNITION_PROVIDER=none
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted instead of GEMINI_API_KEY (the name Google's own tools use).
GEMINI_FOOD_MODEL=gemini-3.8-flash
FOOD_RECOGNITION_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
FOOD_RECOGNITION_EFFORT=medium
FOOD_RECOGNITION_TIMEOUT_MS=45000
# Per user per hour, and all users together per day.
FOOD_SCANS_PER_HOUR=30
FOOD_SCANS_GLOBAL_PER_DAY=5000

# --- AI Coach -----------------------------------------------------------------------------------
# rules (deterministic coaching, always labelled as rules), anthropic (Claude, with the rules coach
# as fallback) or none (coach off).
COACH_PROVIDER=rules
COACH_MODEL=claude-opus-5-5
COACH_TIMEOUT_MS=20000
# Cost control: real AI calls per user per day, chat messages per user per hour, and the
# service-wide daily ceiling.
COACH_DAILY_AI_CALLS=30
COACH_CHAT_PER_HOUR=20
COACH_GLOBAL_DAILY_AI_CALLS=10000

# --- Anthropic credentials (food scanner "anthropic" and the AI coach "anthropic") ---------------
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN is accepted instead of ANTHROPIC_API_KEY.

# --- Billing (FORM Pro) -------------------------------------------------------------------------
# none (Pro can't be bought) or development (a labelled sandbox store that grants Pro without
# payment; refused in production unless APP_STAGE=testing).
BILLING_PROVIDER=none
BILLING_PRODUCT_MONTHLY=form_pro_monthly
BILLING_PRODUCT_ANNUAL=form_pro_annual
# Free trial length in days (0 = no trial offered). Only offer one the store product really has.
BILLING_TRIAL_DAYS=0
# Days of Pro kept after a failed renewal.
BILLING_GRACE_DAYS=16
# Development store only: sandbox display prices and currency.
BILLING_DEV_PRICE_MONTHLY=3.99
BILLING_DEV_PRICE_ANNUAL=28.99
BILLING_DEV_CURRENCY=USD
# Development store only: signs sandbox receipts (32+ characters). Unset = a random secret per
# start, so receipts stop verifying after a restart. Must not be blank if present.
# BILLING_DEV_SECRET=

# --- Free tier allowances (Pro lifts them) -------------------------------------------------------
FREE_SCANS_PER_DAY=3
FREE_COACH_CHAT_PER_DAY=5
FREE_AI_CALLS_PER_DAY=3

# --- Legal links (https only; FORM ships no legal text). Must not be blank if present. -----------
# LEGAL_TERMS_URL=https://example.com/terms
# LEGAL_PRIVACY_URL=https://example.com/privacy
# The API itself serves public GET /privacy, /delete-account and /terms pages (use those URLs in the Play
# Console). SUPPORT_EMAIL is the contact address they show; unset = they point to the store-listing contact.
# SUPPORT_EMAIL=support@example.com

# --- Backups (node dist/backup.js; command-line flags --dir / --keep override these) -------------
BACKUP_DIR=./backups
BACKUP_KEEP=14

# --- Reported at GET /status (optional) ---------------------------------------------------------
# Render sets RENDER_GIT_COMMIT itself; elsewhere set GIT_COMMIT to the deployed commit hash.
# GIT_COMMIT=

# Not here: ads run inside the mobile app, not in this API. Their settings (EXPO_PUBLIC_ADS_MODE,
# ADMOB_* and EXPO_PUBLIC_ADMOB_* ids) are build-time variables, documented in the root README.
