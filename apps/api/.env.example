# Required in production: at least 32 random characters.
JWT_SECRET=
# SQLite file path. Use :memory: for throwaway runs.
DATABASE_PATH=./form.db
PORT=4000
# Comma-separated origins allowed to call the API (Expo web dev server by default).
CORS_ORIGINS=http://localhost:8081
NODE_ENV=development

# External providers. Every one is unconfigured until set; FORM reports that honestly.
AI_PROVIDER_API_KEY=
# Food scanner: anthropic (Claude vision; needs ANTHROPIC_API_KEY), gemini (Google Gemini, has a
# free tier; needs GEMINI_API_KEY), development (a labelled sample meal for local testing only —
# refused in production) or none (scanning reports unavailable).
FOOD_RECOGNITION_PROVIDER=none
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_FOOD_MODEL=gemini-3.8-flash
FOOD_RECOGNITION_MODEL=claude-opus-5-5
FOOD_RECOGNITION_EFFORT=medium
FOOD_SCANS_PER_HOUR=30
FOOD_RECOGNITION_TIMEOUT_MS=30000
APP_STORE_SHARED_SECRET=
PLAY_SERVICE_ACCOUNT=
AD_NETWORK_APP_ID=
ANALYTICS_WRITE_KEY=
